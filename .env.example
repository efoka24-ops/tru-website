# Carrieres RCA (demonstration) — environnement.
#
# A deposer en /home/<compte>/carrieres-rca.env, HORS de public_html.

PUBLIC_URL=https://trugroup.cm/carrieres-rca

# ─── Base de donnees (partagee, tables prefixees rca_) ──────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ─── Securite ───────────────────────────────────────────────────────────────
# Secret des codes par e-mail et du cookie de demonstration.
# php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=
# Code d'acces partage de la demonstration. Vide = portail ouvert a tous
# (a ne faire qu'avec l'accord d'Orange RCA, sur un domaine Orange).
DEMO_ACCESS_CODE=
# Jeton de install.php ; a vider apres l'installation.
INSTALL_TOKEN=
# Adresse du premier recruteur administrateur (cree par install.php).
ADMIN_EMAIL=

# ─── Pieces jointes (hors public_html) ──────────────────────────────────────
# Defaut : /home/<compte>/carrieres-rca-data
DATA_DIR=

# ─── E-mails ────────────────────────────────────────────────────────────────
MAIL_FROM=noreply@trugroup.cm
# SMTP authentifie : sans lui, mail() de l'hebergeur (souvent en spam).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# ─── SMS via teeeotp ────────────────────────────────────────────────────────
TEEEOTP_BASE_URL=https://trugroup.cm/teeeotp
TEEEOTP_API_KEY=
